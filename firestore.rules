rules_version = '2';

// WordSv: each signed-in user can read and write only their own document, users/{uid}.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.v == 1
        && request.resource.data.keys().hasOnly(['v', 'p', 'deleted', 'custom', 'settings', 'log', 'skipped', 'email', 'updatedAt']);
    }
    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
